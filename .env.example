# Copy to .env and fill in your own values. Never commit .env.

# --- Neo4j -------------------------------------------------------------------
# Local Docker: neo4j://localhost:7687   Aura: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-min-8-chars

# --- Source data -------------------------------------------------------------
# supabase = read from your Supabase load (sql/create_table + python ingest.py all)
# csv      = read the SENTINEL CSV export directly (offline)
SOURCE=csv
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Folder that contains transactions/, labels/, customers/, devices/, merchants/
CSV_DIR=./sentinel_data/tables

# Number of transactions to load (earliest first, minimum 5000)
SAMPLE_SIZE=50000
